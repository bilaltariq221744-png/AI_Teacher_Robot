# =============================================================================
# AI Teacher Robot — Environment Variables (Example)
# =============================================================================
# Copy this file to .env and update the values as needed.
#   cp .env.example .env
#
# Environment variables take precedence over values in config.yaml.
# =============================================================================

# --- Application ---
APP_DEBUG=false

# --- Audio ---
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=1024

# --- Speech-to-Text (STT) ---
STT_ENGINE=vosk
STT_LANGUAGE=en
LISTEN_TIMEOUT=5

# --- LLM ---
LLM_API_URL=http://localhost:11434/api/chat
LLM_MODEL=llama3
LLM_TIMEOUT=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# --- Text-to-Speech (TTS) ---
TTS_ENGINE=pyttsx3
TTS_LANGUAGE=en
TTS_RATE=200
TTS_VOLUME=1.0
TTS_VOICE_ID=

# --- Logging ---
LOG_LEVEL=INFO
